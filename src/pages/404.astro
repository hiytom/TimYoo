---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | TIMYOO Apparel" description="The requested page could not be found." canonicalPath="/404.html" robots="noindex, follow">
  <section class="bg-gray-900 px-4 pb-24 pt-44 text-white">
    <div class="mx-auto max-w-7xl">
      <p class="text-sm text-gray-400">404</p>
      <h1 class="mt-4 text-3xl font-bold">Page not found</h1>
      <p class="mt-5 text-gray-300">The page may have moved or the address may be incorrect.</p>
      <a href="/" class="mt-8 inline-block font-semibold text-blue-300 underline underline-offset-4 hover:text-white">Return to TIMYOO Apparel</a>
    </div>
  </section>
</BaseLayout>
