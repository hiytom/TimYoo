---
import logo from '../assets/logo.svg?raw';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="The TIMYOO Apparel website is under construction. Please check back soon." />
    <title>Website Under Construction | TIMYOO Apparel</title>
  </head>
  <body>
    <main>
      <div class="brand" role="img" aria-label="TIMYOO Apparel" set:html={logo} />
      <div class="rule" aria-hidden="true"></div>
      <h1>Website under construction</h1>
      <p>We're working on our website.<br />Please check back soon.</p>
    </main>
  </body>
</html>

<style is:inline>
  * { box-sizing: border-box; }
  html { color-scheme: light; background: #fafafa; }
  body { margin: 0; font-family: Arial, Helvetica, sans-serif; color: #171717; }
  main { display: flex; min-height: 100svh; flex-direction: column; align-items: center; justify-content: center; padding: 64px 24px; text-align: center; }
  .brand { width: min(220px, 65%); }
  .brand svg { display: block; width: 100%; height: auto; }
  .rule { width: 40px; height: 3px; margin: 48px 0 28px; background: #2563eb; }
  h1 { max-width: 640px; margin: 0; font-size: 32px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }
  p { margin: 20px 0 0; color: #666; font-size: 16px; line-height: 1.8; }
  @media (max-width: 480px) { h1 { font-size: 26px; } }
</style>
